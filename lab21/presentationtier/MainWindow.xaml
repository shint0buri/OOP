<Window x:Class="presentationtier.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Анализ товаров (вариант 16)" Height="500" Width="600"
        FontSize="14">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Общая прибыль -->
        <TextBlock Grid.Row="0"
                   Text="{Binding TotalProfit, StringFormat='Общая прибыль: {0:F2} руб.'}"
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,15" />

        <!-- Список товаров -->
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Items}"
                 DisplayMemberPath="Display"
                 Margin="0,0,0,15" />

        <!-- Средняя закупка по группам -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="Средняя закупочная цена по группам:" FontWeight="Bold" Margin="0,0,0,5"/>
            <ItemsControl ItemsSource="{Binding AveragePurchasePriceByGroup}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Path=., StringFormat='{}{0}: {1:F2} руб.'}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</Window>