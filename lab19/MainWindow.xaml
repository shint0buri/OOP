<Window x:Class="lab19.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Лабораторная работа №19 (Вариант 16)" Height="600" Width="800">
    <Window.Resources>
       
        <Style x:Key="BlueGradientStyle" TargetType="Shape">
            <Setter Property="Fill">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="LightBlue" Offset="0"/>
                        <GradientStop Color="DarkSlateBlue" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Stroke" Value="Navy"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.15" ScaleY="1.15"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

       
        <Style x:Key="RedShadowStyle" TargetType="Shape">
            <Setter Property="Fill" Value="Crimson"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="3"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="Red" BlurRadius="20" ShadowDepth="5"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

     
        <Style x:Key="YellowDashedStyle" TargetType="Shape">
            <Setter Property="Fill" Value="Gold"/>
            <Setter Property="Stroke" Value="Orange"/>
            <Setter Property="StrokeThickness" Value="3"/>
            <Setter Property="StrokeDashArray" Value="4 2"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Fill" Value="OrangeRed"/>
                </Trigger>
            </Style.Triggers>
        </Style>

     
        <Style x:Key="GreenSolidStyle" TargetType="Shape">
            <Setter Property="Fill" Value="ForestGreen"/>
            <Setter Property="Stroke" Value="DarkGreen"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Fill" Value="LimeGreen"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Label Content="Количество фигур:" VerticalAlignment="Center"/>
            <TextBox x:Name="txtCount" Width="60" Text="5" VerticalContentAlignment="Center"/>
            <Button x:Name="btnGenerate" Content="Сгенерировать" Margin="10,0" Click="btnGenerate_Click"/>
        </StackPanel>

        <Canvas x:Name="DrawingCanvas" Grid.Row="1" Background="WhiteSmoke" />
    </Grid>
</Window>