<Window x:Class="lab18.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Лабораторная работа №18 — Вариант 16" Height="600" Width="700"
        FontSize="14" Padding="15">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Параметры a, f, N, K -->
        <TextBlock Text="Параметр a:" Margin="5"/>
        <TextBox x:Name="txtA" Grid.Column="1" Margin="5"/>

        <TextBlock Grid.Row="1" Text="Параметр f:" Margin="5"/>
        <TextBox x:Name="txtF" Grid.Row="1" Grid.Column="1" Margin="5"/>

        <TextBlock Grid.Row="2" Text="Количество элементов N (для массива x):" Margin="5"/>
        <TextBox x:Name="txtN" Grid.Row="2" Grid.Column="1" Margin="5" TextChanged="txtN_TextChanged"/>

        <TextBlock Grid.Row="3" Text="Количество элементов K (для массива y):" Margin="5"/>
        <TextBox x:Name="txtK" Grid.Row="3" Grid.Column="1" Margin="5" TextChanged="txtK_TextChanged"/>

        <!-- Место для ввода массивов -->
        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="5">
            <GroupBox Header="Массив x (размер N)">
                <ScrollViewer MaxHeight="100">
                    <StackPanel x:Name="spX"/>
                </ScrollViewer>
            </GroupBox>
            <GroupBox Header="Массив y (размер K)" Margin="10,0,0,0">
                <ScrollViewer MaxHeight="100">
                    <StackPanel x:Name="spY"/>
                </ScrollViewer>
            </GroupBox>
        </StackPanel>

        <!-- Кнопка расчёта -->
        <Button Grid.Row="6" Content="Вычислить Z" Click="btnCalculate_Click" HorizontalAlignment="Center" Padding="15,5" Margin="10"/>
    </Grid>
</Window>